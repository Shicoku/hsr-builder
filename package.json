{
  "name": "buildcard",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "major": "bun pm version major --no-git-tag-version",
    "minor": "bun pm version minor --no-git-tag-version",
    "patch": "bun pm version patch --no-git-tag-version",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "workers:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "workers:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@types/mdx": "^2.0.14",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
